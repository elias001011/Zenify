<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. The sync identity and pairing secrets belong to this
     device, and downloads and local files are large; the library is kept. -->
<full-backup-content>
    <exclude domain="root" path="app_flutter/usernobackup.hive" />
    <exclude domain="root" path="app_flutter/usernobackup.lock" />
    <exclude domain="root" path="app_flutter/tracks" />
    <exclude domain="root" path="app_flutter/artworks" />
    <exclude domain="root" path="app_flutter/local_files" />
</full-backup-content>
